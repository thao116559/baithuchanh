        printf("\n4: Xoa mot nut theo ma sinh vien");
        printf("\n5: Duyet danh sach tu cuoi ve dau");
        printf("\n9: Duyet danh sach tu dau ve cuoi");
        printf("\n0: Thoat");
        printf("\nMoi ban chon: ");

        int chon;
        scanf("%d", &chon);

        switch(chon) {
            case 1:
                printf("Nhap thong tin sv can them\n");
                nhap(&x);

                if(x.masv > 0)
                    insert_Head(&L, x);

                break;

            case 2:
                printf("Nhap thong tin sv can them\n");
                nhap(&x);

                if(x.masv > 0)
                    insert_Tail(&L, x);

                break;

            case 3:
                printf("Nhap ma sinh vien can tim: ");
                scanf("%d", &ma);

                q = L.pHead;

                while(q != NULL && q->infor.masv != ma)
                    q = q->next;

                if(q == NULL)
                    printf("Khong tim thay sinh vien!\n");
