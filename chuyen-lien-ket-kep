
#include<stdio.h>
#include<stdlib.h>

typedef struct {
    char hoten[30];
    int masv;
    float d1, d2, d3;
}Data;

typedef struct tagNode {
    Data infor;
    struct tagNode *next, *prev;
}Node;

typedef struct {
    Node *pHead;
    Node *pTail;
    int spt;
}DList;

void initList(DList *L) {
    L->pHead = NULL;
    L->pTail = NULL;
    L->spt = 0;
}

int emptyList(DList L) {
    return (L.spt == 0);
}

void insert_Head(DList *L, Data x) {
    Node *pp;
    pp = (Node*) malloc(sizeof(Node));

    pp->infor = x;
    pp->next = NULL;
    pp->prev = NULL;

    if(emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        pp->next = L->pHead;
        L->pHead->prev = pp;
        L->pHead = pp;
    }

    L->spt++;
}

void insert_Tail(DList *L, Data x) {
    Node *pp;
    pp = (Node*) malloc(sizeof(Node));

    pp->infor = x;
    pp->next = NULL;
    pp->prev = NULL;

    if(emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        pp->prev = L->pTail;
        L->pTail->next = pp;
        L->pTail = pp;
    }

    L->spt++;
}

void insert_After(DList *L, Node *q, Data x) {
    Node *pp;

    if(q == NULL) return;
    else {
        pp = (Node*) malloc(sizeof(Node));
        pp->infor = x;

        pp->next = q->next;
        pp->prev = q;

        if(q->next != NULL)
            q->next->prev = pp;
        else
            L->pTail = pp;

        q->next = pp;

        L->spt++;
    }
}

void delete_Node(DList *L, int ma) {
    Node *q = L->pHead;

    while(q != NULL && q->infor.masv != ma)
        q = q->next;

    if(q == NULL) {
        printf("Khong tim thay sinh vien!\n");
        return;
    }

    if(q->prev != NULL)
        q->prev->next = q->next;
    else
        L->pHead = q->next;

    if(q->next != NULL)
        q->next->prev = q->prev;
    else
        L->pTail = q->prev;

    free(q);
    L->spt--;

    printf("Xoa thanh cong!\n");
}

void nhap(Data *x) {
    printf("Nhap ma sv: ");
    scanf("%d", &(x->masv));

    if(x->masv > 0) {
        printf("Nhap ho ten: ");
        scanf(" %29[^\n]", x->hoten);

        printf("Nhap diem mon 1: ");
        scanf("%f", &(x->d1));

        printf("Nhap diem mon 2: ");
        scanf("%f", &(x->d2));

        printf("Nhap diem mon 3: ");
        scanf("%f", &(x->d3));
    }
}

void in(Data x) {
    printf("Ten: %s, Ma: %d, Diem 1: %.2f, Diem 2: %.2f, Diem 3: %.2f\n",
           x.hoten, x.masv, x.d1, x.d2, x.d3);
}

void processList(DList L) {
    Node *pp = L.pHead;

    while(pp != NULL) {
        in(pp->infor);
        pp = pp->next;
    }
}

void processListReverse(DList L) {
    Node *pp = L.pTail;

    while(pp != NULL) {
        in(pp->infor);
        pp = pp->prev;
    }
}

int main() {
    DList L;
    int kt = 0;
    Data x;
    int ma;
    Node *q;

    initList(&L);

    do {
        printf("\nChuong trinh lam viec voi DSLK kep SV\n");
        printf("\n1: Them nut vao dau danh sach");
        printf("\n2: Them nut vao cuoi danh sach");
